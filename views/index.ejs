    <!-- Slide 4 -->
    <div class="slide" style="background-image: linear-gradient(to right, rgba(30, 30, 30, 0.95) 0%, rgba(55, 55, 55, 0.5) 60%, rgba(0, 0, 0, 0.2) 100%), url('/images/homepage/IMG_8063.jpg');">
        <div class="slide-content-wrapper">
            <div class="slide-text">
                <span class="slide-subtitle">Luxury Bathroom Fittings</span>
                <h1 class="slide-heading">Transform Your Space<br>into a Home Spa</h1>
                <p class="slide-desc">Upgrade to premium health faucets and multi-way showers designed for comfort.</p>
                <div class="slide-actions">
                    <a href="/products" class="btn">Explore Products</a>
                    <a href="/contact" class="btn btn-outline" style="border-color: #fff; color: #fff !important;">Enquire Now</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 5 -->
    <div class="slide" style="background-image: linear-gradient(to right, rgba(20, 20, 25, 0.95) 0%, rgba(50, 50, 55, 0.5) 60%, rgba(0, 0, 0, 0.2) 100%), url('/images/homepage/IMG_8067.jpg');">
        <div class="slide-content-wrapper">
            <div class="slide-text">
                <span class="slide-subtitle">Exceptional Quality</span>
                <h1 class="slide-heading">Engineered Beyond<br>Standards</h1>
                <p class="slide-desc">Rust-resistant and drip-free fittings that keep their flawless look for years.</p>
                <div class="slide-actions">
                    <a href="/products" class="btn">Explore Products</a>
