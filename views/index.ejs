    </div>
</section>

<!-- Featured Products Section (SEO content) -->
<% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
<section class="section section-cyan" id="featured-products">
    <div class="container">
        <div class="text-center" style="margin-bottom: var(--space-6);">
            <span class="pill-badge reveal">Featured Collection</span>
            <h2 class="reveal delay-1" style="font-size: 2.5rem;">Our Premium Products</h2>
            <p class="reveal delay-2" style="color: var(--text-secondary); max-width: 600px; margin: 0 auto;">Discover NAXZORA's finest bathroom fittings — precision-engineered faucets, showers, and sanitary hardware for modern Indian homes.</p>
            <div class="section-divider reveal delay-2"></div>
        </div>
        <div class="grid">
            <% featuredProducts.forEach(product => { %>
                <a href="/products/<%= product.slug %>" class="card">
                    <div class="card-img">
                        <img src="<%= product.image_url %>" alt="<%= product.name %> - NAXZORA Premium <%= product.category_name %>" loading="lazy" onerror="this.src='https://placehold.co/600x600/eaf7f8/005b69?text=NAXZORA'">
                    </div>
                    <div class="card-content">
                        <span style="font-size: 0.75rem; color: var(--highlight); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600;"><%= product.category_name %></span>
                        <h3 class="card-title" style="margin-top: 0.5rem;"><%= product.name %></h3>
                    </div>
                </a>
            <% }) %>
        </div>
        <div class="text-center reveal" style="margin-top: var(--space-6);">
            <a href="/products" class="btn">View All Products</a>
        </div>
    </div>
</section>
<% } %>

<!-- Product Categories Section (SEO content) -->
<% if (typeof categories !== 'undefined' && categories.length > 0) { %>
<section class="section" style="background: #fff;" id="product-categories">
    <div class="container">
        <div class="text-center" style="margin-bottom: var(--space-6);">
            <span class="pill-badge reveal">Explore by Category</span>
            <h2 class="reveal delay-1" style="font-size: 2.5rem;">Our Product Categories</h2>
            <p class="reveal delay-2" style="color: var(--text-secondary); max-width: 600px; margin: 0 auto;">From premium faucets and rain showers to industrial-grade pipes and elegant bathroom accessories — we have everything for your dream bathroom.</p>
            <div class="section-divider reveal delay-2"></div>
        </div>
        <div class="grid">
            <% categories.forEach(cat => { %>
                <a href="/products?category=<%= cat.slug %>" class="card">
                    <div class="card-img">
                        <img src="<%= cat.image_url %>" alt="<%= cat.name %> - NAXZORA Bathroom Fittings Category" loading="lazy" onerror="this.src='https://placehold.co/600x600/eaf7f8/005b69?text=<%= encodeURIComponent(cat.name) %>'">
                    </div>
                    <div class="card-content">
                        <h3 class="card-title"><%= cat.name %></h3>
                        <p class="card-desc"><%= cat.description ? cat.description.substring(0, 100) + '...' : '' %></p>
                    </div>
                </a>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<!-- Value Proposition Section (SEO keyword-rich content) -->
<section class="parallax-section">
    <div class="container text-center" style="padding: var(--space-12) 0;">
        <h2 class="reveal" style="font-size: 2.5rem; color: #fff; text-transform: uppercase; letter-spacing: 3px; margin-bottom: var(--space-4);">Why Choose NAXZORA?</h2>
        <p class="reveal delay-1" style="color: rgba(255,255,255,0.75); max-width: 800px; margin: 0 auto var(--space-6); line-height: 1.9; font-size: 1.05rem;">
            NAXZORA delivers premium bathroom fittings and sanitary hardware built with precision engineering. Our products combine luxury design with lasting durability — perfect for homes, hotels, and commercial projects across India.
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); max-width: 900px; margin: 0 auto;">
            <div class="reveal delay-1" style="text-align: center;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(249,163,65,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-2);">
                    <i data-lucide="shield-check" style="color: var(--highlight); width: 28px; height: 28px;"></i>
                </div>
                <h3 style="color: #fff; font-size: 1.1rem; margin-bottom: 0.5rem;">Premium Quality</h3>
                <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem;">Crafted from high-grade brass, stainless steel, and CPVC materials.</p>
            </div>
            <div class="reveal delay-2" style="text-align: center;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(249,163,65,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-2);">
                    <i data-lucide="droplets" style="color: var(--highlight); width: 28px; height: 28px;"></i>
                </div>
                <h3 style="color: #fff; font-size: 1.1rem; margin-bottom: 0.5rem;">Water Efficient</h3>
                <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem;">Aerator technology and ceramic disc cartridges for maximum water savings.</p>
            </div>
            <div class="reveal delay-3" style="text-align: center;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(249,163,65,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-2);">
                    <i data-lucide="award" style="color: var(--highlight); width: 28px; height: 28px;"></i>
                </div>
                <h3 style="color: #fff; font-size: 1.1rem; margin-bottom: 0.5rem;">Made in India</h3>
                <p style="color: rgba(255,255,255,0.6); font-size: 0.9rem;">Proudly manufactured in Rajkot, Gujarat — India's hardware capital.</p>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
