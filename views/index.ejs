    <!-- Slide 3 -->
    <div class="slide" style="background-image: linear-gradient(to right, rgba(15, 34, 40, 0.95) 0%, rgba(30, 50, 45, 0.5) 60%, rgba(0, 0, 0, 0.2) 100%), url('/images/homepage/IMG_8061.jpg');">
